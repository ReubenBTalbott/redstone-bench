    },
    "expect": {
     "S": 1,
     "K": 0
    }
   },
   {
    "set": {
     "B": 1
    },
    "expect": {
     "S": 0,
     "K": 1
    }
   },
   {
    "set": {
     "B": 0
    },
    "expect": {
     "S": 1,
     "K": 0
    }
   },
   {
    "set": {
     "A": 1,
     "B": 1,
     "C": 0
    },
    "expect": {
     "S": 0,
     "K": 1
    }
   },
   {
    "set": {
     "A": 0,
